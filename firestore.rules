rules_version = '2';

// FORMA Firestore security rules.
// - Users can only reach their own data under /users/{uid}.
// - Server-managed fields (account status, entitlements, AI conversations,
//   usage, admin config, audit logs, secrets) are never writable by clients.
// - Admin access does NOT go through these rules: the admin console calls
//   Cloud Functions, which verify the `role` custom claim server-side.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function data() { return request.resource.data; }

    // Health details (discomfort, clinician instructions) require explicit consent.
    function hasHealthConsent(uid) {
      let p = get(/databases/$(database)/documents/users/$(uid)/profile/main);
      return p != null && p.data.get('consent', {}).get('healthDetails', false) == true;
    }

    // Every user-owned record carries its own id (so offline retries are idempotent),
    // timestamps, a revision counter, and stays small.
    function validRecord(id) {
      return data().id == id
        && data().createdAt is string
        && data().updatedAt is string
        && data().get('revision', 0) is int
        && data().keys().size() <= 60;
    }

    function validProfile() {
      return data().keys().hasOnly([
          'displayName', 'birthDate', 'heightCm', 'weightKg', 'calcSex', 'pronouns', 'units', 'timeZone',
          'experience', 'goals', 'primaryGoal', 'equipment', 'trainingLocation', 'trainingDays', 'sessionMinutes',
          'preferredExerciseIds', 'avoidedExerciseIds', 'dietPreference', 'allergies', 'activityLevel',
          'sleepTargetHours', 'theme', 'consent', 'onboardingCompletedAt', 'updatedAt'])
        && data().displayName is string && data().displayName.size() > 0 && data().displayName.size() <= 200
        && data().updatedAt is string;
    }

    match /users/{uid} {
      // Account root (status, createdAt, lastActiveAt) is managed by the server.
      allow read: if isUser(uid);
      allow write: if false;

      match /profile/{docId} {
        allow read: if isUser(uid);
        allow create, update: if isUser(uid) && docId == 'main' && validProfile();
        allow delete: if false;
      }

      match /settings/{docId} {
        allow read: if isUser(uid);
        allow write: if isUser(uid)
          && docId in ['healthSync', 'notifications', 'nutritionTargets']
          && data().keys().size() <= 40;
      }

      // Conversations are written only by the AI functions; users can read and delete them.
      match /aiConversations/{cid} {
        allow read, delete: if isUser(uid);
        allow create, update: if false;
        match /messages/{mid} {
          allow read, delete: if isUser(uid);
          allow create, update: if false;
        }
      }

      match /{collection}/{id} {
        allow read, delete: if isUser(uid) && collection in [
          'goals', 'bodyMeasurements', 'progressPhotos', 'workoutPlans', 'workoutSessions', 'nutritionLogs',
          'savedMeals', 'hydrationLogs', 'sleepLogs', 'recoveryCheckIns', 'discomfortLogs', 'clinicianInstructions',
          'mobilitySessions', 'supplementInventory', 'wellnessRoutines'];

        allow create, update: if isUser(uid) && validRecord(id) && (
          collection in [
            'goals', 'bodyMeasurements', 'progressPhotos', 'workoutPlans', 'workoutSessions', 'nutritionLogs',
            'savedMeals', 'hydrationLogs', 'sleepLogs', 'recoveryCheckIns', 'mobilitySessions',
            'supplementInventory', 'wellnessRoutines']
          || (collection in ['discomfortLogs', 'clinicianInstructions'] && hasHealthConsent(uid))
        );
      }
    }

    // Users can read (never write) their own entitlement.
    match /userEntitlements/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // Everything else — feature flags, plans, AI providers & routes, prompts,
    // usage, budgets, counters, audit logs, deletion requests, admin roles and
    // dev secrets — is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
