# Server-only settings for Cloud Functions. Copy to functions/.env (or .env.<project-id>).
# No AI keys here — they live in Google Secret Manager via the Admin Console.
FUNCTIONS_REGION=asia-south1
# Public Firebase Web API key, used only to trigger password-reset emails from the console.
FORMA_WEB_API_KEY=your-web-api-key
# Long random string; makes usage-analytics user hashes non-reversible. Different per environment.
FORMA_USAGE_HASH_SALT=change-me-to-a-long-random-string
FORMA_USAGE_RETENTION_DAYS=90
# Recommended in production once configured (see docs/SECURITY.md).
FORMA_ADMIN_REQUIRE_MFA=false
FORMA_ENFORCE_APP_CHECK=false
