# Public Firebase web config (Firebase console → Project settings → Your apps → Web app).
# These are identifiers, not secrets. Do NOT put any secret in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_FIREBASE_API_KEY=your-web-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef
# Region where Cloud Functions are deployed (must match FUNCTIONS_REGION).
EXPO_PUBLIC_FUNCTIONS_REGION=asia-south1
# Local development against the Firebase Emulator Suite.
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
# Google Sign-In OAuth client IDs (optional; buttons hide when empty).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Links shown at sign-up and in Settings.
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
